# Copy to .env — NEVER commit .env (the repository is public)
NODE_ENV=development
TZ=UTC
DATABASE_URL=postgresql://cb:cb_dev_password@localhost:5432/cement_bar?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# 32+ random bytes, base64 — generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# 32 bytes base64 — AES-256-GCM key for national id / sheba field encryption
FIELD_ENCRYPTION_KEY=change-me
# HMAC key for searchable hashes of national id
FIELD_HASH_KEY=change-me
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
BUSINESS_TIMEZONE=Asia/Tehran
LOG_LEVEL=info
# Tenant shown by public endpoints (/api/public/*). REQUIRED in production (Q-A2); dev falls back to the oldest tenant.
PUBLIC_TENANT_ID=
# Set to true for the background worker process (BullMQ jobs) instead of the HTTP API
WORKER=false
# Web → API proxy target used by Next.js rewrites (compose prod: http://api:4000)
API_INTERNAL_URL=http://localhost:4000
