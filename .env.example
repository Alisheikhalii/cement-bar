# Copy to .env — NEVER commit .env (the repository is public)
NODE_ENV=development
TZ=UTC
DATABASE_URL=postgresql://cb:cb_dev_password@localhost:5432/cement_bar?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# 32+ random bytes, base64 — generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# 32 bytes base64 — AES-256-GCM key for national id / sheba field encryption
FIELD_ENCRYPTION_KEY=change-me
# HMAC key for searchable hashes of national id
FIELD_HASH_KEY=change-me
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
BUSINESS_TIMEZONE=Asia/Tehran
LOG_LEVEL=info
