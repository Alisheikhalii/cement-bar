# Rendered by the official nginx image (envsubst) -> /etc/nginx/conf.d/https.conf
# Only enabled by nginx-start.sh once /etc/letsencrypt/live/${DOMAIN}/ exists.
server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  include /etc/nginx/snippets/security-headers.conf;

  # General per-IP limit for everything on this vhost.
  limit_req zone=general burst=200 nodelay;
  limit_conn perip 100;

  proxy_connect_timeout 5s;
  proxy_send_timeout    60s;
  proxy_read_timeout    60s;

  # --- internal-only endpoints ------------------------------------------------
  # Prometheus scrapes api:4000/api/metrics over the internal docker network.
  location = /api/metrics { return 404; }
  location ^~ /api/metrics/ { return 404; }

  # --- auth: strict brute-force limit (app also limits per IP + username) ------
  location = /api/auth/login {
    limit_req zone=login burst=5 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://cb_api;
  }

  # --- SSE stream ---------------------------------------------------------------
  location ^~ /api/events {
    include /etc/nginx/snippets/proxy.conf;
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    add_header X-Accel-Buffering no;
    include /etc/nginx/snippets/security-headers.conf;
    proxy_pass http://cb_api;
  }

  # --- REST API -------------------------------------------------------------------
  location /api/ {
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://cb_api;
  }

  # --- Next.js hashed static assets: cache forever -----------------------------
  location ^~ /_next/static/ {
    include /etc/nginx/snippets/proxy.conf;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    include /etc/nginx/snippets/security-headers.conf;
    proxy_pass http://cb_web;
  }

  # --- web app (SSR) --------------------------------------------------------------
  location / {
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://cb_web;
  }
}
