# syntax=docker/dockerfile:1.7
# -----------------------------------------------------------------------------
# cement-bar web image (Next.js 15, output: 'standalone').
# Build context = repository root:
#   docker build -f infra/docker/Dockerfile.web -t cement-bar-web .
# Requires next.config: output 'standalone' and outputFileTracingRoot = repo root
# so that the server lands at .next/standalone/apps/web/server.js.
# Same Debian base as the API image (shared layers, glibc for sharp/swc).
# -----------------------------------------------------------------------------
ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE} AS base
ARG PNPM_VERSION=11.11.0
ENV CI=true \
    PNPM_STORE=/pnpm/store \
    TURBO_TELEMETRY_DISABLED=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    CHECKPOINT_DISABLE=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g --no-audit --no-fund "pnpm@${PNPM_VERSION}" && pnpm --version
WORKDIR /repo

FROM base AS fetch
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN pnpm fetch --store-dir "$PNPM_STORE"

FROM fetch AS build
COPY . .
RUN pnpm install --offline --frozen-lockfile --store-dir "$PNPM_STORE"
# Builds @cb/shared (tsup) then @cb/web; @cb/ui is source-only (transpilePackages).
RUN pnpm exec turbo run build --filter=@cb/web...
RUN mkdir -p apps/web/public \
 && test -f apps/web/.next/standalone/apps/web/server.js \
 && test -d apps/web/.next/static

# --- runtime -------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production \
    TZ=UTC \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
# Root-owned => read-only for the runtime user.
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
# Next writes its cache here (mounted as tmpfs in compose.prod.yml).
RUN mkdir -p /app/apps/web/.next/cache && chown node:node /app/apps/web/.next/cache
USER node
EXPOSE 3000
# Any non-5xx answer (incl. redirect to /login) means the server is up.
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/',{redirect:'manual'}).then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/web/server.js"]
